OPENAI_API_KEY=
# Required for Gmail sync. Messages are pulled only from this label.
GMAIL_LABEL=Transactions
AGGREGATOR_REDIS_URL=redis://127.0.0.1:16379/0
# Parser generation backend: ollama (default) or mistral.
PARSER_GENERATION_PROVIDER=ollama
MISTRAL_API_KEY=
# Optional Langfuse tracing for parser generation.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=development
