{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/home/yuvaraj/.agents/skills/impeccable/scripts/impeccable' ] || '/home/yuvaraj/.agents/skills/impeccable/scripts/impeccable' hook",
            "commandWindows": "if exist \"/home/yuvaraj/.agents/skills/impeccable/scripts/impeccable.cmd\" (\"/home/yuvaraj/.agents/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/home/yuvaraj/.agents/skills/impeccable/scripts/impeccable' ] || '/home/yuvaraj/.agents/skills/impeccable/scripts/impeccable' hook",
            "commandWindows": "if exist \"/home/yuvaraj/.agents/skills/impeccable/scripts/impeccable.cmd\" (\"/home/yuvaraj/.agents/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)",
            "timeout": 30,
