  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Setup action with a right-hand keyboard hint.",
      "html": "<button class=\"ds-button-primary\"><span>Add account</span><kbd aria-hidden=\"true\">\u21b5</kbd></button>",
      "css": ".ds-button-primary{font-family:var(--font-sans, 'Schibsted Grotesk', sans-serif);display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:52px;padding:10px 12px 10px 20px;border:0;border-radius:16px;background:var(--action-primary,#393a3e);color:var(--action-primary-ink,#ffffff);font-size:17px;line-height:24px;font-weight:600;cursor:pointer;transition:background-color 150ms,transform 180ms} .ds-button-primary:hover:not(:disabled){background:var(--action-primary-hover,#2c2d30)} .ds-button-primary:active:not(:disabled){transform:scale(.98)} .ds-button-primary:disabled{opacity:.55;cursor:default} .ds-button-primary:focus-visible{outline:2px solid var(--focus-ring,#3b71c6);outline-offset:4px} .ds-button-primary kbd{font-family:var(--font-sans, 'Schibsted Grotesk', sans-serif);display:grid;place-items:center;min-width:26px;height:26px;padding:0 6px;border-radius:6px;font-size:13px;font-weight:400;background:var(--key-chip-primary,#4a4b50);color:var(--key-chip-primary-ink,#d2d3d8)} @media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}} .ds-button-primary:disabled{background:var(--action-primary-disabled,#c9cace);color:var(--action-primary-ink,#fff);opacity:.7}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Setup action with a right-hand keyboard hint.",
      "html": "<button class=\"ds-button-secondary\">Back to accounts</button>",
      "css": ".ds-button-secondary{font-family:var(--font-sans, 'Schibsted Grotesk', sans-serif);display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:52px;padding:10px 12px 10px 20px;border:0;border-radius:16px;background:var(--action-secondary,#dadee6);color:var(--action-secondary-ink,#3a4352);font-size:17px;line-height:24px;font-weight:600;cursor:pointer;transition:background-color 150ms,transform 180ms} .ds-button-secondary:hover:not(:disabled){background:var(--action-secondary-hover,#cfd4dd)} .ds-button-secondary:active:not(:disabled){transform:scale(.98)} .ds-button-secondary:disabled{opacity:.55;cursor:default} .ds-button-secondary:focus-visible{outline:2px solid var(--focus-ring,#3b71c6);outline-offset:4px} .ds-button-secondary kbd{font-family:var(--font-sans, 'Schibsted Grotesk', sans-serif);display:grid;place-items:center;min-width:26px;height:26px;padding:0 6px;border-radius:6px;font-size:13px;font-weight:400;background:var(--key-chip-secondary,#ced3db);color:var(--key-chip-ink,#5b6473)} @media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}"
    },
    {
      "name": "Danger button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Setup action with a right-hand keyboard hint.",
      "html": "<button class=\"ds-button-danger\"><span>Remove account</span><kbd aria-hidden=\"true\">Ctrl /</kbd></button>",
      "css": ".ds-button-danger{font-family:var(--font-sans, 'Schibsted Grotesk', sans-serif);display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:52px;padding:10px 12px 10px 20px;border:0;border-radius:16px;background:var(--action-danger,#f2dde3);color:var(--action-danger-ink,#c4162f);font-size:17px;line-height:24px;font-weight:600;cursor:pointer;transition:background-color 150ms,transform 180ms} .ds-button-danger:hover:not(:disabled){background:var(--action-danger-hover,#ecd0d9)} .ds-button-danger:active:not(:disabled){transform:scale(.98)} .ds-button-danger:disabled{opacity:.55;cursor:default} .ds-button-danger:focus-visible{outline:2px solid var(--focus-ring,#3b71c6);outline-offset:4px} .ds-button-danger kbd{font-family:var(--font-sans, 'Schibsted Grotesk', sans-serif);display:grid;place-items:center;min-width:26px;height:26px;padding:0 6px;border-radius:6px;font-size:13px;font-weight:400;background:var(--key-chip-danger,#e6d1d8);color:var(--key-chip-ink,#5b6473)} @media(prefers-reduced-motion:reduce){.ds-button-danger{transition:none}}"
    },
    {
      "name": "Tabbed account field",
      "kind": "input",
      "refersTo": "input",
      "description": "Name field with a joined label tab and focus border.",
      "html": "<label class=\"ds-label\" for=\"ds-account-name\">Account name</label><div class=\"ds-control\"><input id=\"ds-account-name\" placeholder=\"Enter account name\" maxlength=\"40\"></div>",
      "css": ".ds-label{font-family:var(--font-sans, 'Schibsted Grotesk', sans-serif);display:inline-block;margin:0 0 -2px 20px;padding:4px 12px;border:2px solid var(--border-input,#e1e5eb);border-bottom:0;border-radius:8px 8px 0 0;background:var(--label-grey,#e6e9ee);color:var(--ink-heading,#505b6c);font-size:13px;line-height:18px;font-weight:500;position:relative} .ds-control{display:flex;align-items:center;min-height:52px;padding:0 14px;border:2px solid var(--border-input,#e1e5eb);border-radius:16px;background:var(--surface-paper,#fff)} .ds-control:focus-within{border-color:var(--focus-ring,#3b71c6)} .ds-control input{font-family:var(--font-sans, 'Schibsted Grotesk', sans-serif);width:100%;min-width:0;padding:0;border:0;outline:0;background:transparent;color:var(--ink-body,#333c49);font-size:17px;line-height:24px;font-weight:500} .ds-control input::placeholder{color:var(--ink-placeholder,#727c8b)}"
    },
    {
      "name": "Patterned account card",
      "kind": "card",
      "description": "Ocean identity with the first, folded pattern; one of twenty account themes.",
      "html": "<div class=\"ds-account-card\"><svg viewBox=\"0 0 384 216\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><polygon points=\"0,0 384,0 384,124 70,118 0,150\" fill=\"rgba(0,0,0,.16)\"/><polygon points=\"70,118 384,124 384,216 0,216 0,150\" fill=\"rgba(255,255,255,.1)\"/></svg><span>Account name</span></div>",
      "css": ".ds-account-card{font-family:var(--font-sans, 'Schibsted Grotesk', sans-serif);position:relative;width:340px;max-width:100%;aspect-ratio:16/9;border-radius:16px;overflow:hidden;background:linear-gradient(135deg,#4789a7,#1f6f94 48%,#13455c);color:#d2e2ea} .ds-account-card svg{width:100%;height:100%} .ds-account-card span{position:absolute;top:18px;right:22px;left:22px;text-align:right;font-size:18px;line-height:24px;font-weight:500;letter-spacing:-.01em;overflow-wrap:anywhere;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}"
    },
    {
      "name": "Toast",
      "kind": "custom",
      "description": "Transient confirmation pill; announced by the application status region.",
      "html": "<div class=\"ds-toast\" role=\"status\">Added account</div>",
      "css": ".ds-toast{font-family:var(--font-sans, 'Schibsted Grotesk', sans-serif);display:inline-block;max-width:calc(100% - 32px);border-radius:999px;background:var(--action-primary,#393a3e);color:var(--action-primary-ink,#fff);padding:8px 18px;font-size:13px;line-height:18px;text-align:center}"
    }
  ],
  "narrative": {
    "northStar": "Account cards on a quiet canvas",
    "overview": "The supplied Template Review mockup establishes the visual authority: a quiet, cool canvas, generous space, soft rounded controls, and account cards with visible material character. Preserve this world when extending the interface; the current implementation uses React with plain CSS, not a component-library theme.",
    "keyCharacteristics": [
      "Cool neutral surfaces and charcoal primary actions.",
      "Local Schibsted Grotesk, proportional figures, sentence case.",
      "Tabbed field labels, right-aligned key hints, patterned account cards."
    ],
    "rules": [],
    "dos": [
      "Do reuse the semantic CSS properties and both theme treatments.",
      "Do keep focus visible, keyboard hints accurate, and reduced motion complete.",
      "Do keep footer actions clear of the editor at narrow widths and short heights."
    ],
    "donts": [
      "Don't replace the supplied visual authority with a new palette or font.",
      "Don't reduce secondary or placeholder contrast to match the paler mockup.",
      "Don't treat deferred review components or mockup timers as implemented behavior."
    ]
  }
}
